{
  "expo": {
    "name": "Bütçe Pro",
    "slug": "butce-pro",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "butceapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.avsharbeyi.butceapp"
    },
    "android": {
      "package": "com.avsharbeyi.butceapp",
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      "expo-sharing",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
